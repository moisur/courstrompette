generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STUDENT
}

model User {
  id                 String         @id @default(uuid())
  email              String?        @unique
  passwordHash       String         @map("password_hash")
  role               UserRole
  isActive           Boolean        @default(true) @map("is_active")
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  student            Student?
  refreshTokens      RefreshToken[]
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model Student {
  id            String      @id @default(uuid())
  legacyMongoId String?     @unique @map("legacy_mongo_id")
  userId        String?     @unique @map("user_id")
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  rate          Decimal
  declared      Boolean     @default(false)
  archived      Boolean     @default(false)
  phone         String?
  address       String?
  courseDay     String?     @map("course_day")
  courseHour    String?     @map("course_hour")
  lessons       Lesson[]
  coursePacks   CoursePack[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("students")
}

model CoursePack {
  id               String    @id @default(uuid())
  legacyMongoId    String?   @unique @map("legacy_mongo_id")
  studentId        String    @map("student_id")
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalLessons     Int       @map("total_lessons")
  remainingLessons Int       @map("remaining_lessons")
  purchaseDate     DateTime  @map("purchase_date")
  expiryDate       DateTime? @map("expiry_date")
  price            Decimal
  lessons          Lesson[]
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([studentId], map: "idx_course_packs_student_id")
  @@map("course_packs")
}

model Lesson {
  id            String      @id @default(uuid())
  legacyMongoId String?     @unique @map("legacy_mongo_id")
  studentId     String      @map("student_id")
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date          DateTime
  amount        Decimal
  comment       String?
  isPaid        Boolean     @default(false) @map("is_paid")
  packId        String?     @map("pack_id")
  pack          CoursePack? @relation(fields: [packId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([studentId], map: "idx_lessons_student_id")
  @@index([packId], map: "idx_lessons_pack_id")
  @@map("lessons")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}
